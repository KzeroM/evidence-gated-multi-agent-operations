{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/egmo/schemas/evidence.schema.json",
  "title": "EGMO v2 Evidence Record",
  "type": "object",
  "required": ["document_type", "schema_version", "evidence_record_id", "mission_id", "execution_id", "producer", "subject", "items", "known_limits"],
  "additionalProperties": false,
  "properties": {
    "document_type": {"const": "evidence_record"},
    "schema_version": {"const": "2.0"},
    "evidence_record_id": {"$ref": "common.schema.json#/$defs/evidence_id"},
    "mission_id": {"$ref": "common.schema.json#/$defs/mission_id"},
    "execution_id": {"$ref": "common.schema.json#/$defs/execution_id"},
    "producer": {"$ref": "common.schema.json#/$defs/identity_ref"},
    "subject": {"$ref": "common.schema.json#/$defs/subject"},
    "items": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "required": ["evidence_id", "criterion_ids", "evidence_type", "captured_at", "expires_at", "subject", "description", "result", "details"], "additionalProperties": false,
        "properties": {
          "evidence_id": {"$ref": "common.schema.json#/$defs/evidence_id"},
          "criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/criterion_id"}},
          "evidence_type": {"$ref": "common.schema.json#/$defs/evidence_type"},
          "captured_at": {"$ref": "common.schema.json#/$defs/date_time"},
          "expires_at": {"$ref": "common.schema.json#/$defs/date_time"},
          "subject": {"$ref": "common.schema.json#/$defs/subject"},
          "description": {"$ref": "common.schema.json#/$defs/description"},
          "result": {"enum": ["pass", "fail", "indeterminate"]},
          "details": {"$ref": "common.schema.json#/$defs/evidence_details"}
        },
        "allOf": [
          {"if": {"properties": {"evidence_type": {"enum": ["command_result", "test_result"]}}}, "then": {"properties": {"details": {"$ref": "common.schema.json#/$defs/command_evidence_details"}}}},
          {"if": {"properties": {"evidence_type": {"const": "api_response"}}}, "then": {"properties": {"details": {"$ref": "common.schema.json#/$defs/api_evidence_details"}}}},
          {"if": {"properties": {"evidence_type": {"enum": ["read_back", "artifact"]}}}, "then": {"properties": {"details": {"$ref": "common.schema.json#/$defs/artifact_evidence_details"}}}}
        ]
      }
    },
    "known_limits": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/description"}, "maxItems": 50}
  }
}
