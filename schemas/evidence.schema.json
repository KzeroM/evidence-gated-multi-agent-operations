{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/evidence-gated-multi-agent-operations/schemas/evidence.schema.json",
  "title": "Evidence Record",
  "type": "object",
  "required": ["mission_ref", "execution_ref", "collected_at", "collected_by_role", "criterion_evidence", "commands", "artifacts", "assumptions", "known_limits"],
  "additionalProperties": false,
  "properties": {
    "mission_ref": {"type": "string", "minLength": 1},
    "execution_ref": {"type": "string", "minLength": 1},
    "collected_at": {"type": "string", "minLength": 1},
    "collected_by_role": {"type": "string", "minLength": 1},
    "criterion_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "evidence", "result"],
        "additionalProperties": false,
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "result": {"type": "string", "minLength": 1}
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["intent", "command", "exit_status", "output_summary"],
        "additionalProperties": false,
        "properties": {
          "intent": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "exit_status": {"type": "integer"},
          "output_summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path_or_url", "purpose", "owner", "retention", "retrieval", "integrity"],
        "additionalProperties": false,
        "properties": {
          "path_or_url": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "retention": {"type": "string", "minLength": 1},
          "retrieval": {"type": "string", "minLength": 1},
          "integrity": {"type": "string", "minLength": 1}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "known_limits": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
