{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/egmo/schemas/mission-contract.schema.json",
  "title": "EGMO v2 Mission Contract",
  "type": "object",
  "required": ["document_type", "schema_version", "mission_id", "created_at", "objective", "non_goals", "assumptions", "success_criteria", "allowed_capabilities", "output_ownership", "target_subject", "risk", "approval"],
  "additionalProperties": false,
  "properties": {
    "document_type": {"const": "mission_contract"},
    "schema_version": {"const": "2.0"},
    "mission_id": {"$ref": "common.schema.json#/$defs/mission_id"},
    "created_at": {"$ref": "common.schema.json#/$defs/date_time"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "non_goals": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/description"}, "maxItems": 50},
    "assumptions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/description"}, "maxItems": 50},
    "success_criteria": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "required": ["criterion_id", "condition", "required_evidence_types"], "additionalProperties": false,
        "properties": {
          "criterion_id": {"$ref": "common.schema.json#/$defs/criterion_id"},
          "condition": {"$ref": "common.schema.json#/$defs/description"},
          "required_evidence_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/evidence_type"}}
        }
      }
    },
    "allowed_capabilities": {"$ref": "common.schema.json#/$defs/capabilities"},
    "output_ownership": {"$ref": "common.schema.json#/$defs/output_ownership"},
    "target_subject": {"$ref": "common.schema.json#/$defs/subject"},
    "risk": {"$ref": "common.schema.json#/$defs/risk"},
    "approval": {"$ref": "common.schema.json#/$defs/approval"},
    "rollback_or_compensation_plan": {"$ref": "common.schema.json#/$defs/plan_ref"}
  },
  "allOf": [
    {"if": {"properties": {"risk": {"properties": {"level": {"const": "medium"}}}}}, "then": {"properties": {"approval": {"properties": {"kind": {"const": "explicit"}}}}}},
    {"if": {"properties": {"risk": {"properties": {"level": {"const": "high"}}}}}, "then": {"required": ["rollback_or_compensation_plan"], "properties": {"approval": {"required": ["expires_at"], "properties": {"kind": {"const": "explicit"}}}}}}
  ]
}
