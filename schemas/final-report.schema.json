{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/egmo/schemas/final-report.schema.json",
  "title": "EGMO v2 Final Report",
  "type": "object",
  "required": ["document_type", "schema_version", "report_id", "mission_id", "execution_id", "review_id", "subject", "judgment", "summary", "verified_criterion_ids", "evidence_ids", "changed_or_executed", "outputs", "remaining_risks", "next_actions"],
  "additionalProperties": false,
  "properties": {
    "document_type": {"const": "final_report"},
    "schema_version": {"const": "2.0"},
    "report_id": {"$ref": "common.schema.json#/$defs/id"},
    "mission_id": {"$ref": "common.schema.json#/$defs/mission_id"},
    "execution_id": {"$ref": "common.schema.json#/$defs/execution_id"},
    "review_id": {"$ref": "common.schema.json#/$defs/review_id"},
    "subject": {"$ref": "common.schema.json#/$defs/subject"},
    "judgment": {"enum": ["PASSED", "CHANGES_REQUESTED", "BLOCKED", "INCONCLUSIVE", "PARTIAL_SUCCESS", "CANCELLED", "ROLLED_BACK"]},
    "summary": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/description"}},
    "verified_criterion_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/criterion_id"}},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/evidence_id"}},
    "changed_or_executed": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/description"}},
    "outputs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/output_record"}},
    "remaining_risks": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/description"}},
    "next_actions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/description"}}
  }
}
