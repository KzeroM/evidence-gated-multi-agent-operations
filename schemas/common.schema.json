{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/egmo/schemas/common.schema.json",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 96},
    "mission_id": {"$ref": "#/$defs/id"}, "criterion_id": {"$ref": "#/$defs/id"}, "evidence_id": {"$ref": "#/$defs/id"}, "execution_id": {"$ref": "#/$defs/id"}, "review_id": {"$ref": "#/$defs/id"},
    "date_time": {"type": "string", "format": "date-time"},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "identity_ref": {"type": "string", "pattern": "^(human|service|runtime|model):[A-Za-z0-9][A-Za-z0-9._/@:-]{1,254}$"},
    "evidence_type": {"enum": ["command_result", "read_back", "api_response", "test_result", "artifact"]},
    "subject": {
      "type": "object", "required": ["kind", "algorithm", "value"], "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["git_commit", "file", "oci_image", "deployment", "resource_revision"]},
        "algorithm": {"enum": ["git-sha1", "sha256", "version"]},
        "value": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64}|[A-Za-z0-9][A-Za-z0-9._:@/+~-]{2,255})$"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "allOf": [
        {"if": {"properties": {"algorithm": {"const": "git-sha1"}}}, "then": {"properties": {"value": {"pattern": "^[0-9a-f]{40}$"}}}},
        {"if": {"properties": {"algorithm": {"const": "sha256"}}}, "then": {"properties": {"value": {"pattern": "^[0-9a-f]{64}$"}}}}
      ]
    },
    "capabilities": {
      "type": "object", "required": ["filesystem", "network", "deployment", "database_mutation", "messaging"], "additionalProperties": false,
      "properties": {
        "filesystem": {"type": "object", "required": ["read", "write"], "additionalProperties": false, "properties": {"read": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}}, "write": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}}}},
        "network": {"type": "object", "required": ["domains"], "additionalProperties": false, "properties": {"domains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:\\*\\.)?[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"}}}},
        "deployment": {"type": "boolean"}, "database_mutation": {"type": "boolean"}, "messaging": {"type": "boolean"}
      }
    },
    "output_ownership": {"type": "object", "required": ["owner", "expected_location", "retention", "retrieval_method"], "additionalProperties": false, "properties": {"owner": {"enum": ["project", "artifact_store", "scratch", "user_delivery", "local_only"]}, "expected_location": {"type": "string", "minLength": 1, "maxLength": 500}, "retention": {"enum": ["temporary", "task_artifact", "project_lifetime", "long_term_reference"]}, "retrieval_method": {"$ref": "#/$defs/description"}}},
    "risk": {"type": "object", "required": ["level", "production"], "additionalProperties": false, "properties": {"level": {"enum": ["low", "medium", "high"]}, "production": {"type": "boolean"}}},
    "approval": {"type": "object", "required": ["kind", "approval_id", "approved_by", "approved_at", "scope"], "additionalProperties": false, "properties": {"kind": {"enum": ["policy", "explicit"]}, "approval_id": {"$ref": "#/$defs/id"}, "approved_by": {"$ref": "#/$defs/identity_ref"}, "approved_at": {"$ref": "#/$defs/date_time"}, "expires_at": {"$ref": "#/$defs/date_time"}, "scope": {"$ref": "#/$defs/description"}}},
    "plan_ref": {"type": "string", "format": "uri", "pattern": "^(?:file|https)://[^\\s]+$", "maxLength": 500},
    "execution_state": {"enum": ["DRAFT", "APPROVAL_PENDING", "APPROVED", "RUNNING", "EVIDENCE_PENDING", "REVIEW_PENDING", "PASSED", "BLOCKED", "CHANGES_REQUESTED", "CANCELLED", "PARTIAL_SUCCESS", "ROLLBACK_PENDING", "ROLLED_BACK"]},
    "artifact_ref": {"type": "object", "required": ["uri", "digest"], "additionalProperties": false, "properties": {"uri": {"type": "string", "format": "uri"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "command_evidence_details": {"type": "object", "required": ["command", "exit_status", "started_at", "ended_at", "environment_ref", "output_artifact"], "additionalProperties": false, "properties": {"command": {"type": "string", "minLength": 1, "maxLength": 4000}, "exit_status": {"type": "integer", "minimum": 0, "maximum": 255}, "started_at": {"$ref": "#/$defs/date_time"}, "ended_at": {"$ref": "#/$defs/date_time"}, "environment_ref": {"type": "string", "minLength": 1, "maxLength": 255}, "output_artifact": {"$ref": "#/$defs/artifact_ref"}}},
    "api_evidence_details": {"type": "object", "required": ["source_uri", "artifact"], "additionalProperties": false, "properties": {"source_uri": {"type": "string", "format": "uri"}, "artifact": {"$ref": "#/$defs/artifact_ref"}, "status_code": {"type": "integer", "minimum": 100, "maximum": 599}}},
    "artifact_evidence_details": {"type": "object", "required": ["artifact", "media_type"], "additionalProperties": false, "properties": {"artifact": {"$ref": "#/$defs/artifact_ref"}, "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"}}},
    "evidence_details": {"oneOf": [{"$ref": "#/$defs/command_evidence_details"}, {"$ref": "#/$defs/api_evidence_details"}, {"$ref": "#/$defs/artifact_evidence_details"}]},
    "review_provenance": {"type": "object", "description": "Reviewer provenance. Cross-document validation requires medium/high-risk reviews to use a runtime and review execution distinct from the worker and to have read-only access; low risk may use policy-based or logical separation.", "required": ["runtime_ref", "model_ref", "worker_execution_ref", "context_sources", "context_scope", "access_mode", "read_only", "conflicts"], "additionalProperties": false, "properties": {"runtime_ref": {"$ref": "#/$defs/identity_ref"}, "model_ref": {"$ref": "#/$defs/identity_ref"}, "worker_execution_ref": {"$ref": "#/$defs/execution_id"}, "context_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}}, "context_scope": {"$ref": "#/$defs/description"}, "access_mode": {"enum": ["read_only", "read_write", "offline_packet"]}, "read_only": {"type": "boolean"}, "conflicts": {"type": "array", "items": {"$ref": "#/$defs/description"}}}},
    "output_record": {"type": "object", "required": ["uri", "owner", "retention", "retrieval", "subject"], "additionalProperties": false, "properties": {"uri": {"type": "string", "format": "uri"}, "owner": {"type": "string", "minLength": 1}, "retention": {"type": "string", "minLength": 1}, "retrieval": {"type": "string", "minLength": 1}, "subject": {"$ref": "#/$defs/subject"}}}
  }
}
