{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/egmo/schemas/critic-review.schema.json",
  "title": "EGMO v2 Critic Review",
  "type": "object",
  "required": ["document_type", "schema_version", "review_id", "mission_id", "execution_id", "evidence_record_ids", "reviewed_at", "valid_until", "subject", "reviewer", "review_execution_id", "provenance", "verdict", "criteria", "findings", "must_fix", "deferrals"],
  "additionalProperties": false,
  "properties": {
    "document_type": {"const": "critic_review"},
    "schema_version": {"const": "2.0"},
    "review_id": {"$ref": "common.schema.json#/$defs/review_id"},
    "mission_id": {"$ref": "common.schema.json#/$defs/mission_id"},
    "execution_id": {"$ref": "common.schema.json#/$defs/execution_id"},
    "evidence_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/evidence_id"}},
    "reviewed_at": {"$ref": "common.schema.json#/$defs/date_time"},
    "valid_until": {"$ref": "common.schema.json#/$defs/date_time"},
    "subject": {"$ref": "common.schema.json#/$defs/subject"},
    "reviewer": {"$ref": "common.schema.json#/$defs/identity_ref"},
    "review_execution_id": {"$ref": "common.schema.json#/$defs/execution_id", "description": "Reviewer execution identity; cross-document validation requires it to differ from the worker execution for medium/high risk."},
    "provenance": {"$ref": "common.schema.json#/$defs/review_provenance"},
    "verdict": {"enum": ["PASS", "REQUEST_CHANGES", "BLOCKED", "INCONCLUSIVE"]},
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["criterion_id", "status", "evidence_ids", "rationale"], "additionalProperties": false,
        "properties": {
          "criterion_id": {"$ref": "common.schema.json#/$defs/criterion_id"},
          "status": {"enum": ["satisfied", "not_satisfied", "not_applicable", "insufficient_evidence"]},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/evidence_id"}},
          "rationale": {"$ref": "common.schema.json#/$defs/description"}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/description"}},
    "must_fix": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/description"}},
    "deferrals": {
      "type": "array",
      "items": {"type": "object", "required": ["description", "accepted_by", "expires_at"], "additionalProperties": false, "properties": {"description": {"$ref": "common.schema.json#/$defs/description"}, "accepted_by": {"$ref": "common.schema.json#/$defs/identity_ref"}, "expires_at": {"$ref": "common.schema.json#/$defs/date_time"}}}
    }
  }
}
