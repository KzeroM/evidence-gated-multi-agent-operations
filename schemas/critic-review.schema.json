{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/evidence-gated-multi-agent-operations/schemas/critic-review.schema.json",
  "title": "Critic Review",
  "type": "object",
  "required": ["mission_ref", "execution_ref", "review_ref", "reviewed_at", "reviewer_role", "verdict", "spec_compliance", "evidence_assessment", "trust_boundary_assessment", "public_safety_assessment", "findings", "must_fix", "can_defer"],
  "additionalProperties": false,
  "properties": {
    "mission_ref": {"type": "string", "minLength": 1},
    "execution_ref": {"type": "string", "minLength": 1},
    "review_ref": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1},
    "reviewer_role": {"type": "string", "minLength": 1},
    "verdict": {"type": "string", "enum": ["PASS", "REQUEST_CHANGES"]},
    "spec_compliance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_assessment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "status", "rationale"],
        "additionalProperties": false,
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["satisfied", "not_satisfied", "not_applicable"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "trust_boundary_assessment": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "public_safety_assessment": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "must_fix": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "can_defer": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
